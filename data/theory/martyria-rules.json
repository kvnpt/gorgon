  "_description": "Martyria root sign mapping rules from LayoutService.ts. Maps scale note values to RootSign enum values. Note values: Pa=0, Vou=1, Ga=2, Thi=3, Ke=4, ZoHigh=5, NiHigh=6, PaHigh=7, etc. Negative: Ni=-1, Zo=-2, KeLow=-3, etc.",
  "rootSignsByScale": {
    "Diatonic": {
      "-9": "NanaLow",
      "-8": "DeltaLow",
      "-7": "AlphaLow",
      "-6": "LegetosLow",
      "-5": "NanaLow",
      "-4": "DeltaLow",
      "-3": "AlphaLow",
