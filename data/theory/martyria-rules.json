      "9": "Nana",
      "10": "DeltaDotted",
      "11": "AlphaDotted"
    },
    "HardChromatic": {
      "_rule": "evenNoteValue -> Squiggle, oddNoteValue -> Tilt",
      "method": "currentScaleNote % 2 === 0 ? Squiggle : Tilt"
    },
    "SoftChromatic": {
      "_rule": "evenNoteValue -> SoftChromaticPaRootSign, oddNoteValue -> SoftChromaticSquiggle",
      "method": "currentScaleNote % 2 === 0 ? SoftChromaticPaRootSign : SoftChromaticSquiggle"
    },
    "Zygos": {
      "_inheritsFrom": "Diatonic",
      "_overrides": {
        "0": "Squiggle",
